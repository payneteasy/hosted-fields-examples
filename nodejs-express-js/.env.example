# Server
PORT=3000
# Interface to listen on. Loopback by default: the example speaks plain HTTP and trusts
# X-Forwarded-For, both of which are only safe with a proxy in front. Set 0.0.0.0 knowingly.
LISTEN_ADDR=127.0.0.1
BASE_PATH=/hosted-fields-examples-nodejs-express-js
# Origin the payer's browser reaches this app at, used to build the 3DS return URL
PUBLIC_URL=http://localhost:3000

# Payment Gateway
# Both are given to you with your credentials. API_URL is the gateway root, SDK_URL must be on
# that same host: the SDK refuses to run when it is served from the merchant origin.
# API_URL=https://<gateway-host>/paynet
# SDK_URL=https://<gateway-host>/sdk/hosted-fields/latest/index.js?segment=paynet
API_URL=
SDK_URL=

# Credentials provided by the gateway on onboarding
ENDPOINT_ID=
MERCHANT_LOGIN=
# Shared secret the gateway signs its callbacks with, checked on /result
MERCHANT_CONTROL=

# RSA private key that signs the server calls. Never leaves the server.
# On a server point PRIVATE_KEY_PATH at the key file; locally the inline PEM below is enough.
# PRIVATE_KEY_PATH=/etc/hosted-fields-example/private_key.pem
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"

# Demo order
ORDER_AMOUNT=1.00
ORDER_CURRENCY=USD
