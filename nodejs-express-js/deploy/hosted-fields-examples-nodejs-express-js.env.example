# /etc/hosted-fields-examples-nodejs-express-js.env — chmod 640, owned by root:hosted-fields
# systemd reads one KEY=value per line: no quotes needed, no multi-line values.

PORT=3000
BASE_PATH=/hosted-fields-examples-nodejs-express-js
PUBLIC_URL=https://example.com

# Both are given to you with your credentials. API_URL is the gateway root, SDK_URL must be on
# that same host: the SDK refuses to run when it is served from the merchant origin.
# API_URL=https://<gateway-host>/paynet
# SDK_URL=https://<gateway-host>/assets/libs/hosted-fields/latest/index.js?segment=paynet
API_URL=
SDK_URL=

ENDPOINT_ID=
MERCHANT_LOGIN=
# Shared secret the gateway signs its callbacks with, checked on /result
MERCHANT_CONTROL=
PRIVATE_KEY_PATH=/etc/hosted-fields-examples-nodejs-express-js.key

ORDER_AMOUNT=1.00
ORDER_CURRENCY=USD
