{
  "name": "hosted-fields-example-express-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hosted Fields integration example: Node.js + Express + TypeScript + plain JS",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.ts",
    "build": "tsc --noEmit && node build.mjs",
    "test": "node --test src/*.test.ts",
    "lint": "biome check && tsc --noEmit",
    "format": "biome check --fix && biome format --write"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
