# Formatting for `dotnet format`, which is this example's counterpart of gofmt and cargo fmt.
# Deliberately short: it fixes the things that would otherwise differ between machines, and says
# nothing about how the code should be written.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,html,css,js}]
indent_size = 2

[*.cs]
# One namespace per file, declared without a block — every file here is HostedFields.
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# SHA-1 is not our choice: it is the algorithm the gateway signs its 3DS callbacks with, and the
# checksum has to be computed the way the gateway computed it. See Control.cs. Nothing in this
# repository uses SHA-1 where it had a choice.
dotnet_diagnostic.CA5350.severity = none
