# /etc/systemd/system/hosted-fields-examples-dotnet.service

[Unit]
Description=Hosted Fields example (.NET)
Documentation=https://doc.payneteasy.com/integration/api_use_cases/hosted_fields.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hosted-fields
Group=hosted-fields
WorkingDirectory=/opt/hosted-fields-examples-dotnet

# One variable per line, no multi-line values — hence PRIVATE_KEY_PATH rather than PRIVATE_KEY
EnvironmentFile=/etc/hosted-fields-examples-dotnet.env
# The published app is framework-dependent: the pages and the client scripts are inside the
# assembly, and the .NET 10 runtime is the only thing that has to be installed beside it.
ExecStart=/usr/bin/dotnet /opt/hosted-fields-examples-dotnet/hosted-fields-example-dotnet.dll

Restart=on-failure
RestartSec=5s

# The app reads one key file, writes nothing and listens on loopback only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hosted-fields-examples-dotnet
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
