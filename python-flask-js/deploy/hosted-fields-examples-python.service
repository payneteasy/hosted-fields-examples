# /etc/systemd/system/hosted-fields-examples-python.service

[Unit]
Description=Hosted Fields example (Python + Flask)
Documentation=https://doc.payneteasy.com/integration/api_use_cases/hosted_fields.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hosted-fields
Group=hosted-fields
WorkingDirectory=/opt/hosted-fields-examples-python

# One variable per line, no multi-line values — hence PRIVATE_KEY_PATH rather than PRIVATE_KEY
EnvironmentFile=/etc/hosted-fields-examples-python.env
# ProtectSystem=strict below leaves nowhere to write a __pycache__ next to the sources, and the
# app has no reason to want one
Environment=PYTHONDONTWRITEBYTECODE=1

# gunicorn, not `python app.py`: that branch is the Werkzeug development server. systemd expands
# the two names from the EnvironmentFile, so the port is configured in one place for both.
ExecStart=/opt/hosted-fields-examples-python/.venv/bin/gunicorn \
    --bind ${LISTEN_ADDR}:${PORT} \
    --workers 2 \
    app:app

Restart=on-failure
RestartSec=5s

# The app reads one key file, writes nothing and listens on loopback only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hosted-fields-examples-python
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
