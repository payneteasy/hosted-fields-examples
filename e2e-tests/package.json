{
  "name": "hosted-fields-examples-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local end-to-end tests: every example driven through a browser against a fake gateway",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "playwright test",
    "test:go": "playwright test --project=go-js",
    "test:express": "playwright test --project=nodejs-express-js",
    "test:php": "playwright test --project=php-js",
    "test:python": "playwright test --project=python-flask-js",
    "test:ruby": "playwright test --project=ruby-sinatra-js",
    "test:java": "playwright test --project=java-springboot-js",
    "test:kotlin": "playwright test --project=kotlin-ktor-js",
    "test:rust": "playwright test --project=rust-axum-js",
    "test:dotnet": "playwright test --project=dotnet-aspnetcore-js",
    "test:nextjs": "playwright test --project=nextjs",
    "test:ui": "playwright test --ui",
    "test:docker": "E2E_TARGET=docker playwright test -c playwright.docker.config.ts",
    "test:docker:go": "npm run test:docker -- --project=go-js",
    "test:docker:express": "npm run test:docker -- --project=nodejs-express-js",
    "test:docker:php": "npm run test:docker -- --project=php-js",
    "test:docker:python": "npm run test:docker -- --project=python-flask-js",
    "test:docker:ruby": "npm run test:docker -- --project=ruby-sinatra-js",
    "test:docker:java": "npm run test:docker -- --project=java-springboot-js",
    "test:docker:kotlin": "npm run test:docker -- --project=kotlin-ktor-js",
    "test:docker:rust": "npm run test:docker -- --project=rust-axum-js",
    "test:docker:dotnet": "npm run test:docker -- --project=dotnet-aspnetcore-js",
    "test:docker:nextjs": "npm run test:docker -- --project=nextjs",
    "test:docker:ui": "npm run test:docker -- --ui",
    "report": "playwright show-report",
    "browser": "playwright install chromium",
    "emulator": "node src/emulator/main.ts",
    "lint": "biome check && tsc --noEmit",
    "format": "biome check --fix && biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.2",
    "typescript": "6.0.3"
  }
}
