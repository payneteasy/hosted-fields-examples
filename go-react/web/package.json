{
  "name": "hosted-fields-example-go-react-web",
  "version": "1.0.0",
  "private": true,
  "description": "Hosted Fields integration example: the browser half, React + TypeScript on Rsbuild",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "lint:biome": "biome check && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint:fsd": "steiger ./src",
    "lint": "yarn lint:biome && yarn lint:fsd",
    "format": "biome check --fix && biome format --write"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@rsbuild/core": "1.5.16",
    "@rsbuild/plugin-react": "1.4.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "steiger": "0.6.0",
    "typescript": "6.0.3"
  }
}
