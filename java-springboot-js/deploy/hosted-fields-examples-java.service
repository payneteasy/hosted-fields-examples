# /etc/systemd/system/hosted-fields-examples-java.service

[Unit]
Description=Hosted Fields example (Java, Spring Boot)
Documentation=https://doc.payneteasy.com/integration/api_use_cases/hosted_fields.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hosted-fields
Group=hosted-fields
WorkingDirectory=/opt/hosted-fields-examples-java

# One variable per line, no multi-line values — hence PRIVATE_KEY_PATH rather than PRIVATE_KEY
EnvironmentFile=/etc/hosted-fields-examples-java.env
# The pages and the client scripts are inside the jar, so this is the whole application
ExecStart=/usr/bin/java -jar /opt/hosted-fields-examples-java/hosted-fields-example-java.jar

Restart=on-failure
RestartSec=5s

# The app reads one key file, writes nothing and listens on loopback only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hosted-fields-examples-java
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
