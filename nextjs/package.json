{
  "name": "hosted-fields-example-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Hosted Fields integration example: Next.js + React + TypeScript",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3002}",
    "build": "next build",
    "start": "next start --port ${PORT:-3002}",
    "lint:biome": "biome check && tsc --noEmit",
    "lint:fsd": "steiger ./src",
    "lint": "yarn lint:biome && yarn lint:fsd",
    "format": "biome check --fix && biome format --write"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "steiger": "0.6.0",
    "typescript": "6.0.3"
  }
}
