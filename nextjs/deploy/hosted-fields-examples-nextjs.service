# /etc/systemd/system/hosted-fields-examples-nextjs.service

[Unit]
Description=Hosted Fields example (Next.js + React)
Documentation=https://doc.payneteasy.com/integration/api_use_cases/hosted_fields.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hosted-fields
Group=hosted-fields
WorkingDirectory=/opt/hosted-fields-examples-nextjs

# One variable per line, no multi-line values — hence PRIVATE_KEY_PATH rather than PRIVATE_KEY.
# These reach the app as real environment variables, which is also how the standalone server
# picks up PORT, so nothing here depends on a .env file being present.
EnvironmentFile=/etc/hosted-fields-examples-nextjs.env
# The standalone server binds every interface unless HOSTNAME says otherwise, and this example
# speaks plain HTTP and trusts X-Forwarded-For — both only safe with nginx in front.
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js

Restart=on-failure
RestartSec=5s

# The app reads one key file, writes nothing and listens on loopback only
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hosted-fields-examples-nextjs
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
