# /etc/hosted-fields-examples-nextjs.env — chmod 640, owned by root:hosted-fields
# systemd reads one KEY=value per line: no quotes needed, no multi-line values.

PORT=3002
# Interface to listen on. Loopback by default: the example speaks plain HTTP and trusts
# X-Forwarded-For, both of which are only safe with a proxy in front. Set 0.0.0.0 knowingly.
HOSTNAME=127.0.0.1
# Next bakes basePath into the build, so this one is NOT enough on its own: it has to be set
# for `yarn build` as well, and changing it here means rebuilding. See README.md.
BASE_PATH=/hosted-fields-examples-nextjs
PUBLIC_URL=https://example.com

# Both are given to you with your credentials. API_URL is the gateway root, SDK_URL must be on
# that same host: the SDK refuses to run when it is served from the merchant origin.
# API_URL=https://<gateway-host>/paynet
# SDK_URL=https://<gateway-host>/assets/libs/hosted-fields/latest/index.js?segment=paynet
API_URL=
SDK_URL=

ENDPOINT_ID=
MERCHANT_LOGIN=
# Shared secret the gateway signs its callbacks with, checked on the 3DS return
MERCHANT_CONTROL=
PRIVATE_KEY_PATH=/etc/hosted-fields-examples-nextjs.key

ORDER_AMOUNT=1.00
ORDER_CURRENCY=USD
