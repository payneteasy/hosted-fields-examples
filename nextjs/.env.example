# Server
# Next picks the port before it loads this file, so PORT only takes effect as a real
# environment variable — `yarn dev` and `yarn start` read it from the shell, and systemd
# supplies it through EnvironmentFile. The value here is the default those scripts fall back
# to. Everything else below is read from this file at runtime, in the build as well.
PORT=3002
# Interface to listen on, and read from the shell exactly like PORT above, not from this file.
# Loopback is the default in both `yarn` scripts and in the systemd unit: the example speaks
# plain HTTP and trusts X-Forwarded-For, both of which are only safe with a proxy in front.
# Set 0.0.0.0 knowingly.
HOSTNAME=127.0.0.1
# Next resolves basePath at BUILD time and bakes it into the output, unlike the Go and
# Express examples where BASE_PATH is a plain runtime variable. `next build` reads this
# file too, so the two agree — but change it and you have to rebuild.
BASE_PATH=/hosted-fields-examples-nextjs
# Origin the payer's browser reaches this app at, used to build the 3DS return URL
PUBLIC_URL=http://localhost:3002

# Payment Gateway
# Both are given to you with your credentials. API_URL is the gateway root, SDK_URL must be on
# that same host: the SDK refuses to run when it is served from the merchant origin.
# API_URL=https://<gateway-host>/paynet
# SDK_URL=https://<gateway-host>/assets/libs/hosted-fields/latest/index.js?segment=paynet
API_URL=
SDK_URL=

# Credentials provided by the gateway on onboarding
ENDPOINT_ID=
MERCHANT_LOGIN=
# Shared secret the gateway signs its callbacks with, checked on the 3DS return
MERCHANT_CONTROL=

# RSA private key that signs the server calls. Issued by the gateway on onboarding, PKCS#8.
# It never leaves the server and is never committed: *.pem is git-ignored repository wide.
# PRIVATE_KEY is an alternative, a single-line PEM with escaped \n.
PRIVATE_KEY_PATH=./private_key.pem

# Demo order
ORDER_AMOUNT=1.00
ORDER_CURRENCY=USD
